{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "releaseTag", "commit", "checkedAt", "version", "workingTreeClean", "commands", "latestProof"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseTag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "checkedAt": { "type": "string", "format": "date-time" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "workingTreeClean": { "const": true },
    "commands": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["command", "exitCode", "status"], "properties": { "command": { "type": "string", "minLength": 1 }, "exitCode": { "type": "integer", "minimum": 0 }, "status": { "enum": ["passed", "failed"] } }, "additionalProperties": true } },
    "chronology": { "type": "array", "items": { "type": "object", "required": ["at", "status", "event"], "properties": { "at": { "type": "string", "format": "date-time" }, "status": { "enum": ["passed", "failed", "blocked"] }, "event": { "type": "string", "minLength": 1 }, "command": { "type": "string" }, "exitCode": { "type": "integer" } }, "additionalProperties": true } },
    "latestProof": { "type": "object", "required": ["path", "valid", "notQualityClaim"], "properties": { "path": { "type": "string", "minLength": 1 }, "valid": { "const": true }, "notQualityClaim": { "const": true }, "provider": { "type": "string" }, "model": { "type": "string" } }, "additionalProperties": true }
  },
  "additionalProperties": false
}
