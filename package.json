{
  "name": "toolbastion",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "A zero-trust security gateway for MCP tool calls.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaharMuavia/toolbastion.git"
  },
  "homepage": "https://maharmuavia.github.io/toolbastion/",
  "bugs": {
    "url": "https://github.com/MaharMuavia/toolbastion/issues"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ./scripts/build-workspaces.mjs",
    "clean": "npm run clean --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run tests/unit tests/integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "demo:offline": "node ./apps/cli/dist/index.js demo",
    "evaluate": "node ./scripts/evaluate.mjs",
    "snapshot": "node ./scripts/generate-snapshot.mjs",
    "verify:snapshot": "node ./scripts/verify-snapshot.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "24.0.14",
    "eslint": "9.31.0",
    "globals": "16.3.0",
    "tsup": "8.5.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vitest": "4.1.10"
  }
}
