{
  "name": "toolbastion",
  "version": "0.1.4",
  "private": false,
  "license": "Apache-2.0",
  "description": "A security gateway and evidence layer for mediated MCP calls, with optional target-process containment.",
  "bin": {
    "toolbastion": "dist/standalone/index.js"
  },
  "files": [
    "dist/standalone",
    "apps/dashboard/dist",
    "examples/benign-server/dist",
    "examples/vulnerable-server/dist",
    "fixtures",
    "schemas",
    "toolbastion.config.example.yaml",
    "toolbastion.config.production.example.yaml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaharMuavia/toolbastion.git"
  },
  "homepage": "https://maharmuavia.github.io/toolbastion/",
  "bugs": {
    "url": "https://github.com/MaharMuavia/toolbastion/issues"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:api": "node ./apps/cli/dist/index.js dashboard --config toolbastion.config.example.yaml --port 4782",
    "dev:frontend": "npm run dev --workspace=@toolbastion/dashboard",
    "dev:proxy": "node ./apps/cli/dist/index.js run --config toolbastion.config.example.yaml",
    "build": "node ./scripts/build-workspaces.mjs",
    "build:standalone": "npm run build && npm run build:standalone --workspace=@toolbastion/cli",
    "clean": "npm run clean --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run tests/unit tests/integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:docker-isolation": "node ./scripts/test-docker-isolation.mjs",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "demo:offline": "node ./apps/cli/dist/index.js demo",
    "evaluate": "node ./scripts/evaluate.mjs",
    "benchmark": "node ./scripts/benchmark.mjs",
    "snapshot": "node ./scripts/generate-snapshot.mjs",
    "verify:snapshot": "node ./scripts/verify-snapshot.mjs",
    "artifact:prepare": "npm run build && npm run evaluate && npm run snapshot && npm run build && npm run verify:snapshot",
    "pack:smoke": "node ./scripts/pack-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "24.0.14",
    "eslint": "9.31.0",
    "fast-check": "^4.1.1",
    "globals": "16.3.0",
    "tsup": "8.5.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/static": "10.1.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "commander": "15.0.0",
    "diff": "9.0.0",
    "fastify": "5.10.0",
    "openai": "6.47.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
