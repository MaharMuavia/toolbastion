{
  "name": "mcp-warden",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ./scripts/build-workspaces.mjs",
    "clean": "npm run clean --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run tests/unit tests/integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "demo:offline": "vitest run tests/integration/enforcement.test.ts --reporter=verbose",
    "evaluate": "node ./scripts/evaluate.mjs",
    "snapshot": "node ./scripts/generate-snapshot.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "24.0.14",
    "eslint": "9.31.0",
    "globals": "16.3.0",
    "tsup": "8.5.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vitest": "4.1.10"
  }
}
