{
  "name": "@toolbastion/cli",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "bin": {
    "toolbastion": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup ./src/index.ts --format esm --dts --clean --no-config",
    "build:standalone": "tsup --config package.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "tsup": {
    "entry": ["./src/index.ts"],
    "format": ["esm"],
    "noExternal": ["@toolbastion"],
    "external": ["@fastify/cors", "@fastify/static", "@modelcontextprotocol/sdk", "ajv", "ajv-formats", "commander", "diff", "fastify", "openai", "yaml", "zod"],
    "outDir": "../../dist/standalone",
    "clean": true,
    "splitting": false,
    "sourcemap": true,
    "target": "es2022",
    "platform": "node"
  },
  "dependencies": {
    "@toolbastion/audit": "0.1.4",
    "@toolbastion/api": "0.1.4",
    "@toolbastion/core": "0.1.4",
    "@toolbastion/policy": "0.1.4",
    "@toolbastion/remediation": "0.1.4",
    "@toolbastion/reports": "0.1.4",
    "@toolbastion/shared": "0.1.4",
    "@modelcontextprotocol/sdk": "1.29.0",
    "commander": "15.0.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
